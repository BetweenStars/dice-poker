    nodePosition: {x: 0, y: 0}
    nodeType: 2
    charId: 4
    text: "\uCE74\uC9C0\uB178 \uD30C\uB77C\uB2E4\uC774\uC2A4 \uC8FC\uB825 \uAC8C\uC784\uC778
