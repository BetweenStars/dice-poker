    nodePosition: {x: 0, y: 0}
    nodeType: 2
    charId: 4
    text: "\uC871\uBCF4\uB294 \uD3EC\uCEE4\uC640 \uB3D9\uC77C\uD558\uC9C0\uB9CC \uC8FC\uC0AC\uC704\uB294
